set(CMAKE_SYSTEM_NAME Windows)
set(CMAKE_SYSTEM_PROCESSOR x86)
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
if(NOT DEFINED ENV{LLVM_ROOT})
  set(LLVM_ROOT "/opt/homebrew/opt/llvm")
else()
  set(LLVM_ROOT "$ENV{LLVM_ROOT}")
endif()
if(NOT DEFINED ENV{XWIN_ROOT})
  get_filename_component(XWIN_ROOT "${CMAKE_CURRENT_LIST_DIR}/../.sdk" ABSOLUTE)
else()
  set(XWIN_ROOT "$ENV{XWIN_ROOT}")
endif()
set(CMAKE_CXX_COMPILER "${LLVM_ROOT}/bin/clang-cl")
set(CMAKE_CXX_COMPILER_TARGET i686-pc-windows-msvc)
if(EXISTS "${LLVM_ROOT}/bin/lld-link")
  set(CMAKE_LINKER "${LLVM_ROOT}/bin/lld-link")
else()
  set(CMAKE_LINKER "/opt/homebrew/opt/lld/bin/lld-link")
endif()
set(CMAKE_AR "${LLVM_ROOT}/bin/llvm-lib")
set(CMAKE_RC_COMPILER "${LLVM_ROOT}/bin/llvm-rc")
set(CMAKE_CXX_FLAGS_INIT "--target=i686-pc-windows-msvc /imsvc\"${XWIN_ROOT}/crt/include\" /imsvc\"${XWIN_ROOT}/sdk/include/ucrt\" /imsvc\"${XWIN_ROOT}/sdk/include/shared\" /imsvc\"${XWIN_ROOT}/sdk/include/um\" /imsvc\"${XWIN_ROOT}/sdk/include/winrt\"")
set(CMAKE_EXE_LINKER_FLAGS_INIT "/libpath:\"${XWIN_ROOT}/crt/lib/x86\" /libpath:\"${XWIN_ROOT}/sdk/lib/ucrt/x86\" /libpath:\"${XWIN_ROOT}/sdk/lib/um/x86\"")
set(CMAKE_SHARED_LINKER_FLAGS_INIT "${CMAKE_EXE_LINKER_FLAGS_INIT}")
