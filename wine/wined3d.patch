+        else
+            shader_addline(buffer, "(int(clamp(%s, -2147483648.0, 2147483520.0)) + int(%s >= 2147483648.0) * 127) * int(!isnan(%s)));\n",
+                    src_param.param_str, src_param.param_str, src_param.param_str);
+        return;
+    }
