// Version details shown in the DLLs' Properties > Details.
// CTR2SHIM_PROXY selects the d3dcompiler_47.dll proxy's names.
#include "version.h"
1 VERSIONINFO
FILEVERSION CTR2SHIM_VERSION_NUMBERS
PRODUCTVERSION CTR2SHIM_VERSION_NUMBERS
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS 0x40004L // VOS_NT_WINDOWS32
FILETYPE 0x2L // VFT_DLL
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
#ifdef CTR2SHIM_PROXY
            VALUE "FileDescription", "Cut the Rope 2 UWP shim (D3DCompiler proxy)"
            VALUE "InternalName", "d3dcompiler_47"
            VALUE "OriginalFilename", "d3dcompiler_47.dll"
#else
            VALUE "FileDescription", "Cut the Rope 2 UWP shim"
            VALUE "InternalName", "ctr2shim"
            VALUE "OriginalFilename", "ctr2shim.dll"
#endif
            VALUE "FileVersion", CTR2SHIM_VERSION
            VALUE "ProductName", "ctr2-uwp-shim"
            VALUE "ProductVersion", CTR2SHIM_PRODUCT_VERSION
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
