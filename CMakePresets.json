    {"name": "macos-x86", "generator": "Ninja", "binaryDir": "${sourceDir}/build/macos-x86", "toolchainFile": "${sourceDir}/cmake/clang-cl-xwin.cmake", "cacheVariables": {"CMAKE_BUILD_TYPE": "RelWithDebInfo", "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"}}
  ],
  "buildPresets": [
    {"name": "windows-x86", "configurePreset": "windows-x86"},
    {"name": "macos-x86", "configurePreset": "macos-x86"}
  ]
